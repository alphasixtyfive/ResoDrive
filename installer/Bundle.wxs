<Wix
  xmlns="http://wixtoolset.org/schemas/v4/wxs"
  xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal"
  xmlns:netfx="http://wixtoolset.org/schemas/v4/wxs/netfx"
>
  <Bundle
    Name="$(var.ResoDriveBundleName)"
    Manufacturer="$(var.ResoDrivePublisher)"
    Version="$(var.ResoDriveVersion)"
    UpgradeCode="$(var.ResoDriveBundleUpgradeCode)"
    IconSourceFile="$(var.IconSource)"
  >
    <!-- WiX 5 checks BA conditions before planning; its command-line Uninstall action is 4. -->
    <bal:Condition
      Condition="WixBundleCommandLineAction &lt;&gt; 4"
      Message="To remove ResoDrive, open Windows Settings &gt; Apps &gt; Installed apps and choose Uninstall."
    />
    <bal:Condition Condition="ResoDriveSelectionValid = 1" Message="[ResoDriveSetupError]" />
    <BootstrapperApplication>
      <bal:WixStandardBootstrapperApplication
        Theme="hyperlinkLicense" ThemeFile="SetupTheme.xml"
        LicenseUrl="https://github.com/alphasixtyfive/ResoDrive/blob/main/LICENSE"
        LogoFile="$(var.LogoSource)" SuppressOptionsUI="yes"
        LaunchTarget="[ProgramFiles64Folder]ResoDrive\resodrive-launcher.exe"
        LaunchWorkingFolder="[ProgramFiles64Folder]ResoDrive" />
      <Payload SourceFile="$(var.IconSource)" Name="app.ico" />
      <Payload SourceFile="$(var.SetupFunctionsSource)" bal:BAFunctions="yes" />
    </BootstrapperApplication>

    <netfx:DotNetCoreSearch
      RuntimeType="desktop"
      Platform="x64"
      MajorVersion="10"
      Variable="DotNetDesktopRuntimeVersion"
    />

    <Variable Name="ResoDriveDataRoot" Type="string" Value="" bal:Overridable="yes" />
    <Variable Name="DotNetDesktopRuntimeMinimumVersion" Type="version" Value="$(var.DotNetDesktopRuntimeMinimumVersion)" />
    <!-- The native extension resolves the sentinel to the verified installed
         choice, or standard on a fresh PC. It never chooses compatibility from
         capability detection. Both payloads are immutable builds. -->
    <Variable Name="ResoDriveCompatibilityMode" Type="numeric" Value="-1" Persisted="yes" bal:Overridable="yes" />
    <!-- Coordinated installers can defer opening the app until profile setup
         finishes. The public installer still offers Open ResoDrive by default. -->
    <Variable Name="ResoDriveSuppressLaunch" Type="numeric" Value="0" Persisted="yes" bal:Overridable="yes" />
    <Variable Name="ResoDriveUpgradeCode" Type="string" Value="{$(var.ResoDriveUpgradeCode)}" />
    <Variable Name="ResoDriveSelectionValid" Type="numeric" Value="1" />
    <Variable Name="ResoDriveCanChangeMode" Type="numeric" Value="1" />
    <Variable Name="ResoDriveMissingCetCapability" Type="numeric" Value="0" />
    <Variable Name="ResoDriveShowCompatibilityChoice" Type="numeric" Value="0" />
    <Variable Name="ResoDriveInstalledVersion" Type="string" Value="" />
    <Variable Name="ResoDriveSetupError" Type="string" Value="" />
    <Chain>
      <ExePackage
        Id="DotNetDesktopRuntime"
        DetectCondition="DotNetDesktopRuntimeVersion &gt;= v$(var.DotNetDesktopRuntimeMinimumVersion)"
        InstallArguments="/install /quiet /norestart"
        UninstallArguments="/uninstall /quiet /norestart"
        PerMachine="yes"
        Permanent="yes"
        Cache="remove"
        Vital="yes"
        DisplayName="Microsoft .NET Desktop Runtime 10 (x64)"
      >
        <ExePackagePayload
          Name="windowsdesktop-runtime-$(var.DotNetDesktopRuntimeVersion)-win-x64.exe"
          DownloadUrl="$(var.DotNetDesktopRuntimeUrl)"
          Hash="$(var.DotNetDesktopRuntimeSha512)"
          Size="$(var.DotNetDesktopRuntimeSize)"
        />
      </ExePackage>
      <!-- Windows Installer owns app maintenance; Burn only installs this final package. -->
      <MsiPackage Id="ResoDriveStandard" SourceFile="$(var.StandardMsiSource)" DisplayName="ResoDrive"
        Compressed="yes" Vital="yes" Permanent="yes" Visible="yes"
        InstallCondition="ResoDriveCompatibilityMode = 0" RepairCondition="ResoDriveCompatibilityMode = 0">
        <MsiProperty Name="RDRIVE_FROM_SETUP" Value="1" />
        <MsiProperty Name="RDRIVE_MIGRATE_INSTALL" Value="1" />
        <MsiProperty Name="RDRIVE_DATA_ROOT" Value="[ResoDriveDataRoot]" Condition="ResoDriveDataRoot" />
      </MsiPackage>
      <MsiPackage Id="ResoDriveCompatibility" SourceFile="$(var.CompatibilityMsiSource)" DisplayName="ResoDrive"
        Compressed="yes" Vital="yes" Permanent="yes" Visible="yes"
        InstallCondition="ResoDriveCompatibilityMode = 1" RepairCondition="ResoDriveCompatibilityMode = 1">
        <MsiProperty Name="RDRIVE_FROM_SETUP" Value="1" />
        <MsiProperty Name="RDRIVE_MIGRATE_INSTALL" Value="1" />
        <MsiProperty Name="RDRIVE_DATA_ROOT" Value="[ResoDriveDataRoot]" Condition="ResoDriveDataRoot" />
      </MsiPackage>
    </Chain>
  </Bundle>
</Wix>
