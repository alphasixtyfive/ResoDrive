<Wix
  xmlns="http://wixtoolset.org/schemas/v4/wxs"
  xmlns:netfx="http://wixtoolset.org/schemas/v4/wxs/netfx"
  xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
>
  <Package
    Name="$(var.ResoDriveProductName)"
    Manufacturer="$(var.ResoDrivePublisher)"
    Version="$(var.ResoDriveVersion)"
    UpgradeCode="$(var.ResoDriveUpgradeCode)"
    Language="1033"
    Scope="perMachine"
    InstallerVersion="500"
    Compressed="yes"
  >
    <SummaryInformation Description="$(var.ResoDriveDescription)" />
    <MajorUpgrade
      DowngradeErrorMessage="A newer version of $(var.ResoDriveProductName) is already installed."
      Schedule="afterInstallInitialize"
      AllowSameVersionUpgrades="$(var.ResoDriveAllowSameVersionUpgrades)"
    />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="resodrive.ico" SourceFile="$(var.IconSource)" />
    <Property Id="ARPPRODUCTICON" Value="resodrive.ico" />
    <Property Id="RDRIVE_FROM_SETUP" Secure="yes" />
    <!-- Legacy updaters retain their original executable and activation paths.
         A compatibility-aware updater or current Setup opts in to relocation. -->
    <Property Id="RDRIVE_MIGRATE_INSTALL" Secure="yes" />
    <Property Id="RDRIVE_PREVIOUS_INSTALL_ROOT" Secure="yes">
      <!-- Frozen published SampleProfiles keypath. No Signature row: CompLocator
           returns its containing directory rather than requiring a file signature. -->
      <ComponentSearch Id="PreviousInstallFolder" Guid="2E1BB141-3D85-4177-8498-54A0833D2B23" Type="file" />
    </Property>
    <Property Id="RDRIVE_REGISTERED_INSTALL_ROOT" Secure="yes">
      <RegistrySearch Id="RegisteredInstallFolder" Root="HKLM"
        Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\[WIX_UPGRADE_DETECTED]"
        Name="InstallLocation" Type="raw" Bitness="always64" />
    </Property>
    <Property Id="RDRIVE_INSTALLED_ROOT" Secure="yes">
      <RegistrySearch Id="OwnRegisteredInstallFolder" Root="HKLM"
        Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\[ProductCode]"
        Name="InstallLocation" Type="raw" Bitness="always64" />
    </Property>
    <!-- Resolve the related product's registered location before the missing-root
         launch guard. New versions no longer have the frozen component keypath. -->
    <SetProperty Id="RDRIVE_PREVIOUS_INSTALL_ROOT" Value="[RDRIVE_REGISTERED_INSTALL_ROOT]"
      Before="LaunchConditions" Sequence="both" Condition="WIX_UPGRADE_DETECTED AND RDRIVE_REGISTERED_INSTALL_ROOT" />
    <SetProperty Id="INSTALLFOLDER" Value="[RDRIVE_PREVIOUS_INSTALL_ROOT]"
      After="SetRDRIVE_PREVIOUS_INSTALL_ROOT" Sequence="both"
      Condition="WIX_UPGRADE_DETECTED AND RDRIVE_PREVIOUS_INSTALL_ROOT AND RDRIVE_MIGRATE_INSTALL &lt;&gt; &quot;1&quot;" />
    <!-- Directory defaults are resolved only during costing. Choose the opted-in
         upgrade target now so the migration component condition has both paths. -->
    <SetProperty Id="INSTALLFOLDER" Action="SetCanonicalInstallFolder" Value="[ProgramFiles64Folder]ResoDrive\"
      After="SetINSTALLFOLDER" Sequence="both"
      Condition="NOT Installed AND WIX_UPGRADE_DETECTED AND RDRIVE_PREVIOUS_INSTALL_ROOT AND RDRIVE_MIGRATE_INSTALL = &quot;1&quot; AND ProgramFiles64Folder" />
    <!-- Repair/removal of this product must use its registered location, even
         when this compatibility release was first installed into rdrive. -->
    <SetProperty Id="INSTALLFOLDER" Action="RestoreInstalledFolder" Value="[RDRIVE_INSTALLED_ROOT]"
      After="SetCanonicalInstallFolder" Sequence="both" Condition="Installed AND RDRIVE_INSTALLED_ROOT" />
    <SetProperty Id="ARPINSTALLLOCATION" Value="[INSTALLFOLDER]" After="CostFinalize" Sequence="execute" />
    <Property Id="RDRIVE_MIGRATED_FROM" Secure="yes">
      <RegistrySearch Id="PreviousInstallMigration" Root="HKLM" Key="SOFTWARE\ResoDrive\Installation"
        Name="LegacyInstallLocation" Type="raw" Bitness="always64" />
    </Property>
    <SetProperty Id="RDRIVE_MIGRATED_FROM" Value="[RDRIVE_PREVIOUS_INSTALL_ROOT]"
      After="RestoreInstalledFolder" Sequence="both"
      Condition="WIX_UPGRADE_DETECTED AND RDRIVE_PREVIOUS_INSTALL_ROOT AND INSTALLFOLDER AND RDRIVE_PREVIOUS_INSTALL_ROOT ~&lt;&gt; INSTALLFOLDER" />
    <!-- A legacy hidden MSI still has a visible Burn owner. Let Setup migrate
         that owner natively; an MSI-only update would leave two removable entries. -->
    <Property Id="RDRIVE_PREVIOUS_SYSTEM_COMPONENT" Secure="yes">
      <RegistrySearch
        Id="PreviousSystemComponent"
        Root="HKLM"
        Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\[WIX_UPGRADE_DETECTED]"
        Name="SystemComponent"
        Type="raw"
        Bitness="always64"
      />
    </Property>
    <Property Id="RDRIVE_DATA_ROOT" Secure="yes" />
    <SetProperty Id="RDRIVE_DATA_ROOT" Value="[LocalAppDataFolder]rdrive" Before="CostFinalize" Sequence="execute" Condition="NOT RDRIVE_DATA_ROOT" />
    <!-- Respect an administrator's existing per-executable WER policy as a whole.
         The ownership marker permits our own policy to be replaced by a major upgrade. -->
    <Property Id="RDRIVE_WER_OWNED" Secure="yes">
      <RegistrySearch Id="WerPolicyOwner" Root="HKLM" Key="SOFTWARE\ResoDrive\Diagnostics" Name="LocalDumpsOwned" Type="raw" Bitness="always64" />
    </Property>
    <Property Id="RDRIVE_WER_FOLDER" Secure="yes">
      <RegistrySearch Id="ExistingWerFolder" Root="HKLM" Key="SOFTWARE\Microsoft\Windows\Windows Error Reporting\LocalDumps\resodrive.exe" Name="DumpFolder" Type="raw" Bitness="always64" />
    </Property>
    <Property Id="RDRIVE_WER_COUNT" Secure="yes">
      <RegistrySearch Id="ExistingWerCount" Root="HKLM" Key="SOFTWARE\Microsoft\Windows\Windows Error Reporting\LocalDumps\resodrive.exe" Name="DumpCount" Type="raw" Bitness="always64" />
    </Property>
    <Property Id="RDRIVE_WER_TYPE" Secure="yes">
      <RegistrySearch Id="ExistingWerType" Root="HKLM" Key="SOFTWARE\Microsoft\Windows\Windows Error Reporting\LocalDumps\resodrive.exe" Name="DumpType" Type="raw" Bitness="always64" />
    </Property>
    <Property Id="RDRIVE_WER_FLAGS" Secure="yes">
      <RegistrySearch Id="ExistingWerFlags" Root="HKLM" Key="SOFTWARE\Microsoft\Windows\Windows Error Reporting\LocalDumps\resodrive.exe" Name="CustomDumpFlags" Type="raw" Bitness="always64" />
    </Property>
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch $(var.ResoDriveProductName)" />
    <netfx:DotNetCompatibilityCheck
      Property="DOTNET_DESKTOP_RUNTIME_CHECK"
      RuntimeType="desktop"
      Platform="x64"
      Version="$(var.DotNetDesktopRuntimeMinimumVersion)"
      RollForward="minor"
    />
    <Launch
      Condition="NOT (WIX_UPGRADE_DETECTED &gt;&lt; &quot;;&quot;)"
      Message="Multiple ResoDrive installations are registered. Repair or remove the older entries in Windows Settings, then run the latest ResoDrive-Setup.exe again."
    />
    <Launch
      Condition="Installed OR NOT WIX_UPGRADE_DETECTED OR RDRIVE_PREVIOUS_INSTALL_ROOT"
      Message="The previous ResoDrive installation folder could not be verified. Repair that installation in Windows Settings before updating with the latest ResoDrive-Setup.exe."
    />
    <Launch
      Condition="Installed OR DOTNET_DESKTOP_RUNTIME_CHECK = 0"
      Message="$(var.ResoDriveProductName) requires the .NET 10 Desktop Runtime. Run ResoDrive-Setup.exe to install it automatically."
    />
    <Launch
      Condition="Installed OR NOT WIX_UPGRADE_DETECTED OR RDRIVE_FROM_SETUP = &quot;1&quot; OR (RDRIVE_PREVIOUS_SYSTEM_COMPONENT &lt;&gt; &quot;#1&quot; AND NOT (WIX_UPGRADE_DETECTED &gt;&lt; &quot;;&quot;))"
      Message="Use ResoDrive-Setup.exe to update this installation. Setup will replace its older installer entry and preserve your settings."
    />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="ResoDrive" ComponentGuidGenerationSeed="$(var.ResoDriveComponentSeed)" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="$(var.ResoDriveProductName)" />
    </StandardDirectory>

    <ComponentGroup Id="ApplicationFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.PackageSource)\**">
        <Exclude Files="$(var.PackageSource)\$(var.ResoDriveExecutableName)" />
        <Exclude Files="$(var.PackageSource)\resodrive-launcher.exe" />
        <Exclude Files="$(var.PackageSource)\profiles.sample.json" />
      </Files>
      <Component Id="SampleProfiles" Guid="*">
        <File Id="SampleProfilesFile" Source="$(var.PackageSource)\profiles.sample.json" KeyPath="yes" />
      </Component>
      <Component Id="ResoDriveExecutable" Guid="*">
        <File
          Id="ResoDriveExecutableFile"
          Source="$(var.PackageSource)\$(var.ResoDriveExecutableName)"
          KeyPath="yes"
        />
      </Component>
      <Component Id="ResoDriveLauncher" Guid="*">
        <File Id="ResoDriveLauncherFile" Source="$(var.PackageSource)\resodrive-launcher.exe" KeyPath="yes">
          <Shortcut
            Id="ResoDriveStartMenuShortcut"
            Directory="ApplicationProgramsFolder"
            Name="$(var.ResoDriveProductName)"
            Description="rclone mount and sync manager"
            WorkingDirectory="INSTALLFOLDER"
            Advertise="yes"
            Icon="resodrive.ico"
            IconIndex="0"
          />
        </File>
        <RemoveFolder
          Id="RemoveApplicationProgramsFolder"
          Directory="ApplicationProgramsFolder"
          On="uninstall"
        />
      </Component>
      <Component Id="ResoDriveLocalDumps" Guid="4FD2C558-1556-4B77-A6A3-BB16B2CCF592" Bitness="always64"
        Condition="RDRIVE_WER_OWNED = &quot;#1&quot; OR NOT (RDRIVE_WER_FOLDER OR RDRIVE_WER_COUNT OR RDRIVE_WER_TYPE OR RDRIVE_WER_FLAGS)">
        <!-- NeverOverwrite would skip this component before the transactional
             major upgrade removes the old policy, leaving no dump collection.
             MSI-owned values are restored by repair and every major upgrade. -->
        <!-- Registry values are MSI-formatted: escape the percent signs so this
             remains REG_EXPAND_SZ for the crashing user, never the installing admin. -->
        <RegistryValue Root="HKLM" Key="SOFTWARE\Microsoft\Windows\Windows Error Reporting\LocalDumps\resodrive.exe"
          Name="DumpFolder" Type="expandable" Value="[\%]LOCALAPPDATA[\%]\rdrive-diagnostics\dumps" KeyPath="yes" />
        <RegistryValue Root="HKLM" Key="SOFTWARE\Microsoft\Windows\Windows Error Reporting\LocalDumps\resodrive.exe"
          Name="DumpCount" Type="integer" Value="3" />
        <RegistryValue Root="HKLM" Key="SOFTWARE\Microsoft\Windows\Windows Error Reporting\LocalDumps\resodrive.exe"
          Name="DumpType" Type="integer" Value="2" />
        <RegistryValue Root="HKLM" Key="SOFTWARE\ResoDrive\Diagnostics"
          Name="LocalDumpsOwned" Type="integer" Value="1" />
      </Component>
      <!-- Machine-owned receipt authorizes migration of each user's exact old
           startup task after a real MSI relocation. Carry it through later upgrades. -->
      <Component Id="ResoDriveInstallMigration" Guid="82FBFCB2-D17C-4D0C-8141-6C41C7E38F86"
        Bitness="always64" Condition="(Installed OR WIX_UPGRADE_DETECTED) AND RDRIVE_MIGRATED_FROM">
        <RegistryValue Root="HKLM" Key="SOFTWARE\ResoDrive\Installation"
          Name="LegacyInstallLocation" Type="string" Value="[RDRIVE_MIGRATED_FROM]" KeyPath="yes" />
        <RegistryValue Root="HKLM" Key="SOFTWARE\ResoDrive\Installation"
          Name="InstallLocation" Type="string" Value="[INSTALLFOLDER]" />
        <RegistryValue Root="HKLM" Key="SOFTWARE\ResoDrive\Installation"
          Name="UpgradeCode" Type="string" Value="$(var.ResoDriveUpgradeCode)" />
      </Component>
    </ComponentGroup>

    <ui:WixUI Id="WixUI_Minimal" />

    <CustomAction
      Id="LaunchResoDrive"
      FileRef="ResoDriveLauncherFile"
      ExeCommand=""
      Execute="immediate"
      Return="asyncNoWait"
      Impersonate="yes"
    />
    <!-- Always use preparation code shipped by THIS package, including for legacy upgrades. -->
    <Binary Id="ResoDriveInstallationHelper" SourceFile="$(var.PackageSource)\$(var.ResoDriveExecutableName)" />
    <CustomAction
      Id="PreparePreviousResoDriveForUpgrade"
      BinaryRef="ResoDriveInstallationHelper"
      ExeCommand="--prepare-install &quot;[RDRIVE_PREVIOUS_INSTALL_ROOT].&quot; [UILevel] &quot;[RDRIVE_DATA_ROOT]\.&quot;"
      Execute="immediate" Return="check" Impersonate="yes"
    />
    <CustomAction
      Id="PrepareInstalledResoDriveForUpgrade"
      BinaryRef="ResoDriveInstallationHelper"
      ExeCommand="--prepare-install &quot;[INSTALLFOLDER].&quot; [UILevel] &quot;[RDRIVE_DATA_ROOT]\.&quot;"
      Execute="immediate"
      Return="check"
      Impersonate="yes"
    />
    <CustomAction
      Id="UnregisterResoDriveAutostart"
      FileRef="ResoDriveExecutableFile"
      ExeCommand="--unregister-autostart"
      Execute="immediate"
      Return="ignore"
      Impersonate="yes"
    />

    <InstallUISequence>
      <FindRelatedProducts Before="AppSearch" />
    </InstallUISequence>

    <InstallExecuteSequence>
      <FindRelatedProducts Before="AppSearch" />
      <!--
        Drain work before replacing or removing installed files. Match processes
        by installation path so portable copies are never stopped.
      -->
      <Custom Action="PreparePreviousResoDriveForUpgrade" Before="PrepareInstalledResoDriveForUpgrade"
        Condition="WIX_UPGRADE_DETECTED AND RDRIVE_PREVIOUS_INSTALL_ROOT AND RDRIVE_PREVIOUS_INSTALL_ROOT ~&lt;&gt; INSTALLFOLDER" />
      <Custom
        Action="PrepareInstalledResoDriveForUpgrade"
        Before="InstallValidate"
        Condition="WIX_UPGRADE_DETECTED OR Installed"
      />
      <Custom
        Action="UnregisterResoDriveAutostart"
        Before="RemoveFiles"
        Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE"
      />
    </InstallExecuteSequence>

    <UI>
      <ProgressText Action="PreparePreviousResoDriveForUpgrade" Message="Safely stopping the previous ResoDrive installation" />
      <ProgressText Action="PrepareInstalledResoDriveForUpgrade" Message="Safely stopping ResoDrive before installation" />
      <Publish
        Dialog="ExitDialog"
        Control="Finish"
        Event="DoAction"
        Value="LaunchResoDrive"
        Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT (REMOVE = &quot;ALL&quot;)"
      />
    </UI>

    <Feature Id="MainFeature" Title="$(var.ResoDriveProductName)" Level="1">
      <ComponentGroupRef Id="ApplicationFiles" />
    </Feature>
  </Package>
</Wix>
