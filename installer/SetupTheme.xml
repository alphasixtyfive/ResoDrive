<Theme xmlns="http://wixtoolset.org/schemas/v4/thmutil">
  <Font Id="0" Height="-13" Weight="400" Foreground="windowtext" Background="window">Segoe UI</Font>
  <Font Id="1" Height="-24" Weight="600" Foreground="windowtext">Segoe UI</Font>
  <Font Id="2" Height="-12" Weight="400" Foreground="595959">Segoe UI</Font>
  <Font Id="3" Height="-18" Weight="600" Foreground="windowtext">Segoe UI</Font>
  <Font Id="4" Height="-1" Foreground="d9d9d9" Background="d9d9d9">Segoe UI</Font>
  <Window Width="500" Height="340" FontId="0" Caption="ResoDrive Setup" IconFile="app.ico">
    <ImageControl X="20" Y="12" Width="80" Height="80" ImageFile="logo.png" Visible="yes" />
    <Label X="116" Y="26" Width="-28" Height="32" FontId="1" Visible="yes" DisablePrefix="yes">[WixBundleName]</Label>
    <Label X="116" Y="56" Width="-28" Height="20" FontId="2" Visible="yes" DisablePrefix="yes">Version [WixBundleVersion]</Label>
    <Label X="0" Y="-64" Width="0" Height="1" FontId="4" Visible="yes" />
    <Page Name="Loading">
      <Label X="28" Y="120" Width="-28" Height="30" FontId="0">Preparing setup...</Label>
    </Page>
    <Page Name="Install">
      <Label X="28" Y="118" Width="-28" Height="44" FontId="0">Access your cloud storage as a drive in Windows.</Label>
      <Label X="28" Y="166" Width="-28" Height="58" FontId="2">Installs for all users of this PC. Windows will ask for administrator permission.&#10;The .NET Desktop Runtime is downloaded only if needed.</Label>
      <Hypertext Name="EulaHyperlink" X="28" Y="236" Width="200" Height="24" FontId="2" TabStop="yes">&lt;a href="#"&gt;MIT licence&lt;/a&gt;</Hypertext>
      <Button Name="InstallButton" X="-128" Y="-18" Width="112" Height="30" TabStop="yes" FontId="0">Install</Button>
      <Button Name="InstallCancelButton" X="-24" Y="-18" Width="88" Height="30" TabStop="yes" FontId="0"><Text>Cancel</Text><CloseWindowAction /></Button>
    </Page>
    <Page Name="Progress">
      <Label X="28" Y="118" Width="-28" Height="30" FontId="3"><Text>Installing ResoDrive</Text><Text Condition="WixBundleAction = 4">Removing ResoDrive</Text><Text Condition="WixBundleAction = 8">Repairing ResoDrive</Text></Label>
      <Label Name="OverallProgressPackageText" X="28" Y="160" Width="-28" Height="44" FontId="0">Preparing...</Label>
      <Progressbar Name="OverallCalculatedProgressbar" X="28" Y="218" Width="-28" Height="14" />
      <Button Name="ProgressCancelButton" X="-24" Y="-18" Width="88" Height="30" TabStop="yes" FontId="0">Cancel</Button>
    </Page>
    <Page Name="Modify">
      <Label X="28" Y="118" Width="-28" Height="30" FontId="3">ResoDrive is installed</Label>
      <Label X="28" Y="160" Width="-28" Height="92" FontId="0">Repair the installation or remove ResoDrive.&#10;Running drives and sync jobs will stop. Close documents opened from these drives first.&#10;Your settings and local cache are kept.</Label>
      <Button Name="RepairButton" X="-244" Y="-18" Width="100" Height="30" TabStop="yes" FontId="0" HideWhenDisabled="yes">Repair</Button>
      <Button Name="UninstallButton" X="-128" Y="-18" Width="112" Height="30" TabStop="yes" FontId="0">Uninstall</Button>
      <Button Name="ModifyCancelButton" X="-24" Y="-18" Width="88" Height="30" TabStop="yes" FontId="0"><Text>Close</Text><CloseWindowAction /></Button>
    </Page>
    <Page Name="Success">
      <Label X="28" Y="118" Width="-28" Height="30" FontId="3"><Text>Setup complete</Text><Text Condition="WixBundleAction = 6">ResoDrive is ready</Text><Text Condition="WixBundleAction = 4">ResoDrive was removed</Text></Label>
      <Label X="28" Y="160" Width="-28" Height="60" FontId="0" VisibleCondition="WixBundleAction = 6">Open ResoDrive to manage your drives.&#10;Existing connections and settings are preserved.</Label>
      <Label X="28" Y="160" Width="-28" Height="60" FontId="0" VisibleCondition="WixBundleAction = 4">Your settings, credentials and local cache are still on this PC.</Label>
      <Label X="28" Y="236" Width="-28" Height="24" FontId="2" VisibleCondition="WixStdBARestartRequired">Restart Windows to finish setup.</Label>
      <Button Name="LaunchButton" X="-128" Y="-18" Width="164" Height="30" TabStop="yes" FontId="0" HideWhenDisabled="yes">Open ResoDrive</Button>
      <Button Name="SuccessRestartButton" X="-128" Y="-18" Width="164" Height="30" TabStop="yes" FontId="0" HideWhenDisabled="yes">Restart Windows</Button>
      <Button Name="SuccessCloseButton" X="-24" Y="-18" Width="88" Height="30" TabStop="yes" FontId="0"><Text>Close</Text><CloseWindowAction /></Button>
    </Page>
    <Page Name="Failure">
      <Label X="28" Y="118" Width="-28" Height="30" FontId="3">Setup could not finish</Label>
      <Hypertext Name="FailureMessageText" X="28" Y="160" Width="-28" Height="66" FontId="0" TabStop="yes" HideWhenDisabled="yes" />
      <Hypertext Name="FailureLogFileLink" X="28" Y="236" Width="-28" Height="24" FontId="0" TabStop="yes" HideWhenDisabled="yes">Open the &lt;a href="#"&gt;setup log&lt;/a&gt; for details.</Hypertext>
      <Button Name="FailureRestartButton" X="-128" Y="-18" Width="164" Height="30" TabStop="yes" FontId="0" HideWhenDisabled="yes">Restart Windows</Button>
      <Button Name="FailureCloseButton" X="-24" Y="-18" Width="88" Height="30" TabStop="yes" FontId="0"><Text>Close</Text><CloseWindowAction /></Button>
    </Page>
    <Page Name="Help">
      <Label X="28" Y="118" Width="-28" Height="136" FontId="0">/install, /repair or /uninstall&#10;/quiet for unattended setup&#10;/norestart to prevent an automatic restart&#10;/log path to save a setup log</Label>
      <Button Name="HelpCloseButton" X="-24" Y="-18" Width="88" Height="30" TabStop="yes" FontId="0"><Text>Close</Text><CloseWindowAction /></Button>
    </Page>
  </Window>
</Theme>
