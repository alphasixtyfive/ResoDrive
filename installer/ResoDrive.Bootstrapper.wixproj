<Project Sdk="WixToolset.Sdk/5.0.2">
  <PropertyGroup>
    <OutputType>Bundle</OutputType>
    <InstallerPlatform>x64</InstallerPlatform>
    <NuGetLockFilePath>packages.bootstrapper.lock.json</NuGetLockFilePath>
    <DefaultItemExcludes>$(DefaultItemExcludes);Package.wxs</DefaultItemExcludes>
    <OutputName>$(ResoDriveExecutableBaseName)-$(ResoDriveRuntime)-$(ResoDriveVersion)-setup</OutputName>
    <ResoDriveBundleName>$(ResoDriveProductName)</ResoDriveBundleName>
    <DefineConstants>
      StandardMsiSource=$(StandardMsiSource);
      CompatibilityMsiSource=$(CompatibilityMsiSource);
      SetupFunctionsSource=$(SetupFunctionsSource);
      ResoDriveVersion=$(ResoDriveVersion);
      ResoDriveProductName=$(ResoDriveProductName);
      ResoDriveBundleName=$(ResoDriveBundleName);
      ResoDriveUpgradeCode=$(ResoDriveUpgradeCode);
      ResoDrivePublisher=$(ResoDrivePublisher);
      ResoDriveBundleUpgradeCode=$(ResoDriveBundleUpgradeCode);
      DotNetDesktopRuntimeVersion=$(DotNetDesktopRuntimeVersion);
      DotNetDesktopRuntimeMinimumVersion=$(DotNetDesktopRuntimeMinimumVersion);
      DotNetDesktopRuntimeUrl=$(DotNetDesktopRuntimeUrl);
      DotNetDesktopRuntimeSha512=$(DotNetDesktopRuntimeSha512);
      DotNetDesktopRuntimeSize=$(DotNetDesktopRuntimeSize);
      LogoSource=$(MSBuildProjectDirectory)\..\src\ResoDrive.App\Assets\resodrive-mark.png;
      IconSource=$(MSBuildProjectDirectory)\..\src\ResoDrive.App\resodrive.ico
    </DefineConstants>
  </PropertyGroup>

  <Target Name="ValidateResoDriveBundleProperties" BeforeTargets="Build">
    <Error Condition="'$(StandardMsiSource)' == ''" Text="StandardMsiSource must point to the built standard MSI." />
    <Error Condition="'$(CompatibilityMsiSource)' == ''" Text="CompatibilityMsiSource must point to the built compatibility MSI." />
    <Error Condition="'$(SetupFunctionsSource)' == ''" Text="SetupFunctionsSource must point to the native Setup functions DLL." />
    <Error Condition="'$(ResoDriveVersion)' == ''" Text="ResoDriveVersion is required." />
    <Error Condition="'$(ResoDriveRuntime)' == ''" Text="ResoDriveRuntime is required." />
    <Error Condition="'$(ResoDriveProductName)' == ''" Text="ResoDriveProductName is required." />
    <Error Condition="'$(ResoDrivePublisher)' == ''" Text="ResoDrivePublisher is required." />
    <Error Condition="'$(ResoDriveBundleUpgradeCode)' == ''" Text="ResoDriveBundleUpgradeCode is required." />
    <Error Condition="'$(ResoDriveUpgradeCode)' == ''" Text="ResoDriveUpgradeCode is required." />
    <Error Condition="'$(DotNetDesktopRuntimeVersion)' == ''" Text="DotNetDesktopRuntimeVersion is required." />
    <Error Condition="'$(DotNetDesktopRuntimeMinimumVersion)' == ''" Text="DotNetDesktopRuntimeMinimumVersion is required." />
    <Error Condition="'$(DotNetDesktopRuntimeUrl)' == ''" Text="DotNetDesktopRuntimeUrl is required." />
    <Error Condition="'$(DotNetDesktopRuntimeSha512)' == ''" Text="DotNetDesktopRuntimeSha512 is required." />
    <Error Condition="'$(DotNetDesktopRuntimeSize)' == ''" Text="DotNetDesktopRuntimeSize is required." />
  </Target>

  <ItemGroup>
    <PackageReference Include="WixToolset.BootstrapperApplications.wixext" />
    <PackageReference Include="WixToolset.Netfx.wixext" />
  </ItemGroup>
</Project>
