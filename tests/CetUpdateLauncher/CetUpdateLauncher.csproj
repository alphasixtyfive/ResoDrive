<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <UseAppHost>false</UseAppHost>
    <RootNamespace>ResoDrive.CetUpdateLauncher</RootNamespace>
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
  </PropertyGroup>
  <!-- Reference the already built production library; never rebuild shared application outputs. -->
  <ItemGroup>
    <Reference Include="ResoDrive.Windows"><HintPath>$(ProductionWindowsAssemblyPath)</HintPath></Reference>
    <Reference Include="ResoDrive.Core"><HintPath>$([System.IO.Path]::GetDirectoryName('$(ProductionWindowsAssemblyPath)'))/ResoDrive.Core.dll</HintPath></Reference>
  </ItemGroup>
</Project>
