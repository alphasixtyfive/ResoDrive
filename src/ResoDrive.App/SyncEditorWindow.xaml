<Window
  x:Class="ResoDrive.App.SyncEditorWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="clr-namespace:ResoDrive.App"
  xmlns:controls="clr-namespace:ResoDrive.App.Controls"
  Title="Sync settings"
  Width="540"
  Height="690"
  MinWidth="500"
  MinHeight="530"
  WindowStartupLocation="CenterOwner"
  ShowInTaskbar="False"
  Background="{StaticResource WindowBrush}"
  Foreground="{StaticResource TextBrush}"
>
  <Grid Margin="22,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Margin="0,0,0,12">
      <TextBlock x:Name="Heading" Text="New sync job" FontSize="20" FontWeight="SemiBold" />
      <TextBlock
        Text="Copy or mirror files between a remote and a local folder."
        Foreground="{StaticResource MutedBrush}"
        Margin="0,3,0,0"
      />
    </StackPanel>

    <ScrollViewer
      x:Name="EditorScrollViewer"
      Grid.Row="1"
      VerticalScrollBarVisibility="Auto"
      HorizontalScrollBarVisibility="Disabled"
    >
      <Grid Margin="0,0,8,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="120" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" MinHeight="40" />
          <RowDefinition Height="Auto" MinHeight="40" />
          <RowDefinition Height="Auto" MinHeight="40" />
          <RowDefinition Height="Auto" MinHeight="40" />
          <RowDefinition Height="Auto" MinHeight="40" />
          <RowDefinition Height="Auto" MinHeight="40" />
          <RowDefinition Height="Auto" MinHeight="40" />
          <RowDefinition Height="Auto" MinHeight="40" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Drive" VerticalAlignment="Center" />
        <ComboBox
          x:Name="MountBox"
          Grid.Column="1"
          Style="{StaticResource EditorComboBox}"
          DisplayMemberPath="DisplayName"
          SelectionChanged="Mount_Changed"
          AutomationProperties.Name="Drive"
        />

        <TextBlock Grid.Row="1" Text="Name" VerticalAlignment="Center" />
        <TextBox
          x:Name="NameBox"
          Grid.Row="1"
          Grid.Column="1"
          Style="{StaticResource EditorTextBox}"
          AutomationProperties.Name="Sync job name"
        />

        <TextBlock Grid.Row="2" Text="Remote folder" VerticalAlignment="Center" />
        <TextBox
          x:Name="RemotePathBox"
          Grid.Row="2"
          Grid.Column="1"
          Style="{StaticResource EditorTextBox}"
          ToolTip="Optional folder on the selected remote."
          AutomationProperties.Name="Remote folder"
        />

        <TextBlock Grid.Row="3" Text="Local folder" VerticalAlignment="Center" />
        <Grid Grid.Row="3" Grid.Column="1">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBox
            x:Name="LocalPathBox"
            Style="{StaticResource EditorTextBox}"
            AutomationProperties.Name="Local folder"
          />
          <Button
            x:Name="BrowseLocalFolderButton"
            Grid.Column="1"
            Style="{StaticResource ButtonStyle}"
            Height="32"
            VerticalAlignment="Center"
            Margin="8,0,0,0"
            Padding="10,0"
            Click="BrowseLocalFolder_Click"
            ToolTip="Choose a local folder"
            ToolTipService.ShowOnDisabled="True"
            AutomationProperties.Name="Browse for local folder"
          >
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource InlineButtonGlyph}" Text="&#xE838;" />
              <TextBlock x:Name="LocalFolderButtonLabel" Text="Browse…" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </Grid>

        <TextBlock Grid.Row="4" Text="Operation" VerticalAlignment="Center" />
        <ComboBox
          x:Name="ModeBox"
          Grid.Row="4"
          Grid.Column="1"
          Style="{StaticResource EditorComboBox}"
          SelectionChanged="Mode_Changed"
          AutomationProperties.Name="Sync operation"
        />

        <StackPanel Grid.Row="5" Grid.Column="1" Margin="0,4,0,8">
          <CheckBox
            x:Name="ManagedLocalCopyBox"
            Content="Keep a managed local copy"
            Checked="ManagedLocalCopy_Changed"
            Unchecked="ManagedLocalCopy_Changed"
            AutomationProperties.Name="Keep a managed local copy"
          />
          <TextBlock
            x:Name="LocalCopyNotice"
            Foreground="{StaticResource MutedBrush}"
            TextWrapping="Wrap"
            Margin="0,5,0,0"
          />
        </StackPanel>

        <TextBlock Grid.Row="6" Text="Availability" VerticalAlignment="Center" />
        <CheckBox
          x:Name="EnabledBox"
          Grid.Row="6"
          Grid.Column="1"
          Content="Enabled"
          AutomationProperties.Name="Sync job enabled"
          VerticalAlignment="Center"
        />

        <TextBlock Grid.Row="7" Text="Schedule" VerticalAlignment="Center" />
        <StackPanel
          Grid.Row="7"
          Grid.Column="1"
          Orientation="Horizontal"
          VerticalAlignment="Center"
        >
          <CheckBox
            x:Name="ScheduleBox"
            Content="Run every"
            Checked="Schedule_Changed"
            Unchecked="Schedule_Changed"
            AutomationProperties.Name="Run on a schedule"
          />
          <TextBox
            x:Name="IntervalBox"
            Style="{StaticResource EditorTextBox}"
            Width="58"
            Margin="10,0,8,0"
            AutomationProperties.Name="Schedule interval in minutes"
          />
          <TextBlock
            x:Name="IntervalLabel"
            Text="minutes"
            VerticalAlignment="Center"
            Foreground="{StaticResource MutedBrush}"
          />
        </StackPanel>

        <TextBlock Grid.Row="8" Text="Startup" VerticalAlignment="Center" />
        <CheckBox
          x:Name="RunOnStartBox"
          Grid.Row="8"
          Grid.Column="1"
          Content="{x:Static local:ProductInfo.RunSyncOnStartText}"
          AutomationProperties.Name="{x:Static local:ProductInfo.RunSyncOnStartText}"
          VerticalAlignment="Center"
        />

        <Border
          x:Name="MirrorWarning"
          Grid.Row="9"
          Grid.ColumnSpan="2"
          Background="{DynamicResource ControlBrush}"
          CornerRadius="6"
          Padding="10,8"
          Margin="0,7,0,0"
          Visibility="Collapsed"
        >
          <TextBlock
            Text="Mirror can delete files that exist only at the destination. You will be asked to confirm before it runs."
            Foreground="{DynamicResource WarningBrush}"
            TextWrapping="Wrap"
          />
        </Border>

        <Expander
          Grid.Row="10"
          Grid.ColumnSpan="2"
          Header="Advanced"
          Margin="0,7,0,0"
        >
          <StackPanel Margin="0,6,0,0">
            <TextBlock Text="Additional rclone options" FontWeight="SemiBold" />
            <TextBlock
              Text="One option per line. Keep values together, for example --timeout=1m."
              Foreground="{StaticResource MutedBrush}"
              TextWrapping="Wrap"
              Margin="0,3,0,0"
            />
            <TextBox
              x:Name="ArgumentsBox"
              Style="{StaticResource ArgumentTextBox}"
              Margin="0,7,0,0"
              AcceptsReturn="True"
              AutomationProperties.Name="Additional rclone options"
            />
          </StackPanel>
        </Expander>
      </Grid>
    </ScrollViewer>

    <Grid Grid.Row="2" Margin="0,14,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Button
        x:Name="DeleteButton"
        Style="{StaticResource DangerButton}"
        HorizontalAlignment="Left"
        Click="Delete_Click"
        AutomationProperties.Name="Delete sync job"
      >
        <StackPanel Orientation="Horizontal">
          <TextBlock Style="{StaticResource InlineButtonGlyph}" Text="&#xE74D;" />
          <TextBlock Text="Delete" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
        <Button
          Style="{StaticResource ButtonStyle}"
          Content="Cancel"
          Margin="0,0,8,0"
          IsCancel="True"
        />
        <Button
          Style="{StaticResource AccentButton}"
          Content="Save"
          IsDefault="True"
          Click="Save_Click"
        />
      </StackPanel>
      <controls:ScrollBarGutter Grid.Column="2" ScrollOwner="{Binding ElementName=EditorScrollViewer}" />
    </Grid>
  </Grid>
</Window>
