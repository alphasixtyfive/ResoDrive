<Window x:Class="ResoDrive.App.UploadsWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="clr-namespace:ResoDrive.App"
  Title="Uploads" Width="360" MaxWidth="360" MaxHeight="400" SizeToContent="Height"
  WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="Manual" ShowInTaskbar="False" Topmost="True"
  Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>
  <Window.Resources>
    <Style x:Key="FlyoutNavigationAction" TargetType="Button" BasedOn="{StaticResource ButtonStyle}">
      <Setter Property="Height" Value="30"/>
      <Setter Property="MinHeight" Value="30"/>
      <Setter Property="MinWidth" Value="30"/>
      <Setter Property="Padding" Value="6,0"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template">
        <Setter.Value><ControlTemplate TargetType="Button">
          <Grid Background="Transparent">
            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
          </Grid>
        </ControlTemplate></Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{StaticResource FocusBrush}"/></Trigger>
        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="Foreground" Value="{StaticResource FocusBrush}"/></Trigger>
        <Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value="0.8"/></Trigger>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Foreground" Value="{StaticResource DisabledTextBrush}"/>
          <Setter Property="Cursor" Value="Arrow"/>
        </Trigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="16,16,16,8">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock Text="{x:Static local:ProductInfo.Name}" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
      <Button x:Name="DismissButton" Grid.Column="1" Style="{StaticResource IconOnlyButton}" Content="&#xE8BB;"
        Width="30" MinWidth="30" Height="30" MinHeight="30" FontSize="12"
        Background="Transparent" BorderThickness="0" Foreground="{StaticResource MutedBrush}" ToolTip="Dismiss"
        AutomationProperties.Name="Dismiss upload progress" Click="Dismiss_Click"/>
    </Grid>
    <TextBlock Grid.Row="1" Text="{Binding Summary}" TextWrapping="Wrap" Margin="16,0,16,12"
      AutomationProperties.LiveSetting="Polite">
      <TextBlock.Style>
        <Style TargetType="TextBlock"><Style.Triggers>
          <DataTrigger Binding="{Binding Summary}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
        </Style.Triggers></Style>
      </TextBlock.Style>
    </TextBlock>
    <ScrollViewer Grid.Row="2" Margin="16,0" MaxHeight="260" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <ScrollViewer.Style>
        <Style TargetType="ScrollViewer"><Style.Triggers>
          <DataTrigger Binding="{Binding Files.Count}" Value="0"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
        </Style.Triggers></Style>
      </ScrollViewer.Style>
      <ItemsControl ItemsSource="{Binding Files}">
        <ItemsControl.Style>
          <Style TargetType="ItemsControl"><Style.Triggers>
            <DataTrigger Binding="{Binding ComputedVerticalScrollBarVisibility, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" Value="Visible">
              <Setter Property="Margin" Value="0,0,8,0"/>
            </DataTrigger>
          </Style.Triggers></Style>
        </ItemsControl.Style>
        <ItemsControl.ItemTemplate><DataTemplate>
          <Border Style="{StaticResource Card}" Padding="10" Margin="0,0,0,6"><StackPanel>
            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
            <TextBlock Text="{Binding Detail}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
            <ProgressBar Style="{StaticResource SlimProgressBar}" Minimum="0" Maximum="100" Value="{Binding Percent, Mode=OneWay}"
              Visibility="{Binding ProgressVisibility}" Height="4" Margin="0,7,0,3" AutomationProperties.Name="Upload progress"/>
            <TextBlock Text="{Binding ProgressText}" Visibility="{Binding ProgressTextVisibility}" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
          </StackPanel></Border>
        </DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
    <Border Grid.Row="3" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,8,0,0" Padding="12,4">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Button x:Name="OpenMainWindowButton" Content="{x:Static local:ProductInfo.OpenLabel}" Style="{StaticResource FlyoutNavigationAction}" HorizontalAlignment="Left"
          Click="OpenMainWindow_Click" AutomationProperties.Name="Open ResoDrive main window"/>
        <Button x:Name="OpenSettingsButton" Grid.Column="1" Content="&#xE713;" Style="{StaticResource FlyoutNavigationAction}" Width="30"
          FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Padding="0" ToolTip="Settings"
          Click="OpenSettings_Click" AutomationProperties.Name="Open ResoDrive settings"/>
      </Grid>
    </Border>
  </Grid>
</Window>
