<Window
  x:Class="ResoDrive.App.MountEditorWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="clr-namespace:ResoDrive.App"
  xmlns:controls="clr-namespace:ResoDrive.App.Controls"
  Title="Drive settings"
  Width="520"
  Height="540"
  MinWidth="480"
  MinHeight="500"
  WindowStartupLocation="CenterOwner"
  ShowInTaskbar="False"
  Background="{StaticResource WindowBrush}"
  Foreground="{StaticResource TextBrush}"
>
  <Grid Margin="22,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Margin="0,0,0,12">
      <TextBlock x:Name="Heading" Text="Add drive" FontSize="20" FontWeight="SemiBold" />
      <TextBlock
        x:Name="ConnectionText"
        Text="Mount another folder from your configured storage."
        Foreground="{StaticResource MutedBrush}"
        Margin="0,3,0,0"
      />
    </StackPanel>

    <ScrollViewer
      x:Name="EditorScrollViewer"
      Grid.Row="1"
      VerticalScrollBarVisibility="Auto"
      HorizontalScrollBarVisibility="Disabled"
    >
      <Grid Margin="0,0,8,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="116" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" MinHeight="40" />
          <RowDefinition Height="Auto" MinHeight="40" />
          <RowDefinition Height="Auto" MinHeight="40" />
          <RowDefinition Height="Auto" MinHeight="40" />
          <RowDefinition Height="Auto" MinHeight="40" />
          <RowDefinition Height="Auto" MinHeight="40" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Name" VerticalAlignment="Center" />
        <TextBox x:Name="NameBox" Grid.Column="1" Style="{StaticResource EditorTextBox}" AutomationProperties.Name="Drive name" />

        <TextBlock Grid.Row="1" Text="Folder" VerticalAlignment="Center" />
        <TextBox
          x:Name="RemotePathBox"
          Grid.Row="1"
          Grid.Column="1"
          Style="{StaticResource EditorTextBox}"
          ToolTip="Optional folder inside the storage connection. Leave empty for its root."
          AutomationProperties.Name="Remote folder"
        />

        <TextBlock Grid.Row="2" Text="Drive letter" VerticalAlignment="Center" />
        <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,4,0,8">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="88" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="DriveBox" Style="{StaticResource EditorComboBox}"
                      AutomationProperties.Name="Drive letter" />
            <CheckBox x:Name="NetworkModeBox" Grid.Column="1" Content="Network drive"
                      Margin="12,0,0,0" VerticalAlignment="Center"
                      ToolTip="Tell Windows this is remote storage. Turning this off presents a local drive."
                      AutomationProperties.Name="Present as a network drive" />
          </Grid>
          <TextBlock
            x:Name="DriveStatusText"
            Text="Checking…"
            Foreground="{StaticResource MutedBrush}"
            Margin="0,4,0,0"
            TextWrapping="Wrap"
            VerticalAlignment="Center"
            AutomationProperties.LiveSetting="Polite"
          />
          <TextBlock Text="Network mode tells Windows this is remote storage. Local mode can attract installer temporary files. Office may create temporary files in either mode."
                     TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,6,0,0" />
        </StackPanel>

        <TextBlock Grid.Row="3" Text="Availability" VerticalAlignment="Center" />
        <CheckBox
          x:Name="EnabledBox"
          Grid.Row="3"
          Grid.Column="1"
          Content="Enabled"
          AutomationProperties.Name="Drive enabled"
          VerticalAlignment="Center"
        />

        <TextBlock Grid.Row="4" Text="Startup" VerticalAlignment="Center" />
        <CheckBox
          x:Name="AutoMountBox"
          Grid.Row="4"
          Grid.Column="1"
          Content="{x:Static local:ProductInfo.MountOnStartText}"
          AutomationProperties.Name="{x:Static local:ProductInfo.MountOnStartText}"
          VerticalAlignment="Center"
        />

        <TextBlock Grid.Row="5" Text="Recovery" VerticalAlignment="Center" />
        <StackPanel
          Grid.Row="5"
          Grid.Column="1"
          Orientation="Horizontal"
          VerticalAlignment="Center"
        >
          <CheckBox
            x:Name="RestartBox"
            Content="Reconnect"
            Margin="0,0,12,0"
            Checked="Restart_Changed"
            Unchecked="Restart_Changed"
            AutomationProperties.Name="Reconnect automatically"
          />
          <TextBlock Text="up to" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
          <TextBox
            x:Name="AttemptsBox"
            Style="{StaticResource EditorTextBox}"
            Width="48"
            Margin="8,0"
            ToolTip="Maximum reconnect attempts; 0 keeps trying"
            AutomationProperties.Name="Maximum reconnect attempts; 0 keeps trying"
          />
          <TextBlock Text="times (0 keeps trying)" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
        </StackPanel>

        <Expander
          Grid.Row="6"
          Grid.ColumnSpan="2"
          Header="Advanced"
          Margin="0,7,0,0"
        >
          <controls:MountOptionsControl x:Name="OptionsEditor" Margin="0,6,0,0" />
        </Expander>
      </Grid>
    </ScrollViewer>

    <Grid Grid.Row="2" Margin="0,14,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Button
        x:Name="DeleteButton"
        Style="{StaticResource DangerButton}"
        HorizontalAlignment="Left"
        Click="Delete_Click"
        AutomationProperties.Name="Delete drive"
      >
        <StackPanel Orientation="Horizontal">
          <TextBlock Style="{StaticResource InlineButtonGlyph}" Text="&#xE74D;" />
          <TextBlock Text="Delete" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
        <Button
          Style="{StaticResource ButtonStyle}"
          Content="Cancel"
          Margin="0,0,8,0"
          IsCancel="True"
        />
        <Button
          x:Name="SaveButton"
          Style="{StaticResource AccentButton}"
          Content="Save"
          IsDefault="True"
          Click="Save_Click"
        />
      </StackPanel>
      <controls:ScrollBarGutter Grid.Column="2" ScrollOwner="{Binding ElementName=EditorScrollViewer}" />
    </Grid>
  </Grid>
</Window>
