<UserControl x:Class="ResoDrive.App.Controls.MountOptionsControl"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <TextBlock Text="Caching" Margin="0,0,0,4" />
    <ComboBox x:Name="ModeBox" Style="{StaticResource EditorComboBox}"
      DisplayMemberPath="Label" SelectedValuePath="Value" SelectionChanged="Option_Changed"
      AutomationProperties.Name="Caching" />
    <TextBlock x:Name="ModeHint" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,10" />
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <TextBlock Text="Cache size target" Margin="0,0,0,4" />
        <ComboBox x:Name="SizeBox" Grid.Row="1" Style="{StaticResource EditorComboBox}" IsEditable="True"
          DisplayMemberPath="Label" SelectedValuePath="Value" SelectionChanged="Option_Changed"
          ToolTip="Choose a target or enter a custom rclone size, for example 3G. G means GiB."
          AutomationProperties.Name="Cache size target" />
        <TextBlock Grid.Column="2" Text="Keep unused cached files for" TextWrapping="Wrap" Margin="0,0,0,4" />
        <ComboBox x:Name="AgeBox" Grid.Row="1" Grid.Column="2" Style="{StaticResource EditorComboBox}" IsEditable="True"
          DisplayMemberPath="Label" SelectedValuePath="Value" SelectionChanged="Option_Changed"
          ToolTip="Choose a duration or enter a custom value, for example 48h. Measured since last access."
          AutomationProperties.Name="Keep unused cached files for" />
    </Grid>
    <TextBlock Text="The size target applies to this mount and can be exceeded while files are in use. Retention is measured since last access. You can type custom values."
      Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,12" />
    <TextBlock Text="Additional rclone options" FontWeight="SemiBold" />
    <TextBlock Text="One --option=value or standalone switch per line. Use the controls above for cache options."
      Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,3,0,5" />
    <TextBox x:Name="ArgumentsBox" Style="{StaticResource ArgumentTextBox}" MinHeight="82" MaxHeight="150"
      AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextChanged="Options_TextChanged"
      AutomationProperties.Name="Additional rclone options" />
    <Expander Header="Configured performance options" Margin="0,8,0,0" Expanded="Summary_Expanded">
      <StackPanel>
        <TextBlock Text="These values apply after saving and reconnecting. They do not describe an already running mount."
          Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,5" />
        <TextBox x:Name="SummaryBox" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0"
          Background="Transparent" Foreground="{StaticResource MutedBrush}"
          AutomationProperties.Name="Configured performance options" />
      </StackPanel>
    </Expander>
  </StackPanel>
</UserControl>
