<Window x:Class="ResoDrive.App.AboutWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="clr-namespace:ResoDrive.App"
  Title="{x:Static local:ProductInfo.AboutTitle}" Width="468" SizeToContent="Height"
  ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
  Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}">
  <Window.Resources>
    <Style TargetType="Hyperlink">
      <Setter Property="Foreground" Value="{DynamicResource AccentHoverBrush}" />
      <Setter Property="TextDecorations" Value="{x:Null}" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="TextDecorations" Value="Underline" /></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="TextDecorations" Value="Underline" /></Trigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>
  <StackPanel Margin="24">
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="48" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <Image Width="48" Height="48" Source="Assets/resodrive-mark.png" Stretch="Uniform"
        VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
      <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
        <TextBlock Text="{x:Static local:ProductInfo.Name}" FontSize="18" FontWeight="SemiBold" />
        <TextBlock x:Name="VersionText" FontSize="12" Margin="0,2,0,0" Foreground="{StaticResource MutedBrush}" />
      </StackPanel>
    </Grid>
    <TextBlock Text="Mount Nextcloud, WebDAV, and SFTP storage as Windows drives."
      TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,14,0,0" />
    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0">
      <Run Text="By " /><Hyperlink NavigateUri="{x:Static local:ProductInfo.DeveloperPage}" RequestNavigate="OpenLink" ToolTip="Developer on GitHub"><Run Text="{x:Static local:ProductInfo.DeveloperName}" /></Hyperlink><Run Text=". Licensed under the " /><Hyperlink NavigateUri="{x:Static local:ProductInfo.LicensePage}" RequestNavigate="OpenLink" ToolTip="MIT License on GitHub">MIT License</Hyperlink><Run Text="." />
    </TextBlock>
    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,14,0,10" />
    <TextBlock TextWrapping="Wrap" LineHeight="26">
      <Hyperlink NavigateUri="{x:Static local:ProductInfo.RepositoryPage}" RequestNavigate="OpenLink" AutomationProperties.Name="Open ResoDrive repository on GitHub">GitHub ↗</Hyperlink>
      <Run Text="     " />
      <Hyperlink NavigateUri="{x:Static local:ProductInfo.ReleasesPage}" RequestNavigate="OpenLink" AutomationProperties.Name="Open ResoDrive releases on GitHub">Releases ↗</Hyperlink>
      <Run Text="     " />
      <Hyperlink NavigateUri="{x:Static local:ProductInfo.IssuesPage}" RequestNavigate="OpenLink" AutomationProperties.Name="Report a ResoDrive issue on GitHub">Report an issue ↗</Hyperlink>
    </TextBlock>
  </StackPanel>
</Window>
