<Window
  x:Class="ResoDrive.App.SetupWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="clr-namespace:ResoDrive.App"
  xmlns:controls="clr-namespace:ResoDrive.App.Controls"
  Title="Add drive"
  Width="660"
  Height="690"
  MinWidth="560"
  MinHeight="420"
  ResizeMode="CanResize"
  WindowStartupLocation="CenterOwner"
  ShowInTaskbar="False"
  Background="{StaticResource WindowBrush}"
  Foreground="{StaticResource TextBrush}"
>
  <Grid Margin="24,16,24,14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Margin="0,0,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="48" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Image
        Width="48"
        Height="48"
        HorizontalAlignment="Left"
        Source="Assets/resodrive-mark.png"
        Stretch="Uniform"
        RenderOptions.BitmapScalingMode="HighQuality"
        AutomationProperties.Name="{x:Static local:ProductInfo.Name}"
      />
      <StackPanel Grid.Column="1" Margin="8,2,0,0">
        <TextBlock Text="Add a storage drive" FontSize="18" FontWeight="SemiBold" />
        <TextBlock
          x:Name="SetupSubtitle"
          Text="Choose a profile or configure a connection manually."
          Foreground="{StaticResource MutedBrush}"
          Margin="0,2,0,0"
        />
      </StackPanel>
    </Grid>

    <!-- One responsive scroll surface is used for the complete form. It stays
         hidden at the normal window size and prevents nested scrollbars when
         profiles are added or the available work area is unusually small. -->
    <ScrollViewer
      x:Name="SetupScrollViewer"
      Grid.Row="1"
      VerticalScrollBarVisibility="Auto"
      HorizontalScrollBarVisibility="Disabled"
      CanContentScroll="False"
    >
      <StackPanel>
        <StackPanel x:Name="ProfilePanel">
          <TextBlock Text="Profile" FontWeight="SemiBold" Margin="0,0,0,6" />
          <TextBlock
            x:Name="ProfileSourceText"
            Visibility="Collapsed"
            Foreground="{StaticResource MutedBrush}"
            FontSize="11"
            TextTrimming="CharacterEllipsis"
            Margin="0,2,0,7"
          />
          <StackPanel Margin="0,0,0,8">
            <ComboBox
              x:Name="ProfileCombo"
              MaxDropDownHeight="320"
              TextSearch.TextPath="DisplayName"
              SelectionChanged="ProfileSelection_Changed"
              AutomationProperties.Name="Connection profile"
            >
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock
                    Text="{Binding DisplayName}"
                    TextTrimming="CharacterEllipsis"
                    ToolTip="{Binding Description}"
                  />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock
              Text="{Binding SelectedItem.Description, ElementName=ProfileCombo}"
              Foreground="{StaticResource MutedBrush}"
              TextWrapping="Wrap"
              TextTrimming="CharacterEllipsis"
              MaxHeight="36"
              ToolTip="{Binding SelectedItem.Description, ElementName=ProfileCombo}"
              AutomationProperties.HelpText="{Binding SelectedItem.Description, ElementName=ProfileCombo}"
              Margin="0,6,0,0"
            />
          </StackPanel>
        </StackPanel>

        <Border Style="{StaticResource Card}" Padding="12">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="118" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="Type" VerticalAlignment="Center" />
            <ComboBox
              x:Name="ConnectionTypeBox"
              Grid.Column="1"
              Style="{StaticResource EditorComboBox}"
              Margin="0,0,0,8"
              SelectionChanged="ConnectionType_Changed"
              AutomationProperties.Name="Storage type"
            />

            <TextBlock x:Name="ServerLabel" Grid.Row="1" Text="Server URL" VerticalAlignment="Center" />
            <TextBox x:Name="ServerBox" Grid.Row="1" Grid.Column="1" Style="{StaticResource EditorTextBox}" Margin="0,0,0,8" AutomationProperties.Name="Server address" />

            <TextBlock x:Name="PortLabel" Grid.Row="2" Text="Port" VerticalAlignment="Center" Visibility="Collapsed" />
            <TextBox x:Name="PortBox" Grid.Row="2" Grid.Column="1" Style="{StaticResource EditorTextBox}" Width="88" HorizontalAlignment="Left" Text="22" Margin="0,0,0,8" Visibility="Collapsed" AutomationProperties.Name="SFTP port" />

            <TextBlock x:Name="UsernameLabel" Grid.Row="3" Text="Username" VerticalAlignment="Center" />
            <TextBox
              x:Name="UsernameBox"
              Grid.Row="3"
              Grid.Column="1"
              Style="{StaticResource EditorTextBox}"
              Margin="0,0,0,8"
              AutomationProperties.Name="Username"
            />

            <TextBlock x:Name="AuthenticationLabel" Grid.Row="4" Text="Authentication" VerticalAlignment="Center" Visibility="Collapsed" />
            <Grid x:Name="AuthenticationPanel" Grid.Row="4" Grid.Column="1" Margin="0,0,0,8" Visibility="Collapsed">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="126" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <ComboBox x:Name="AuthenticationBox" Style="{StaticResource EditorComboBox}" SelectionChanged="Authentication_Changed" AutomationProperties.Name="SFTP authentication method" />
              <TextBox x:Name="KeyFileBox" Grid.Column="2" Style="{StaticResource EditorTextBox}" Visibility="Collapsed" IsReadOnly="True" ToolTip="Path to a PEM or OpenSSH private key file" AutomationProperties.Name="Private key file" />
              <Button x:Name="BrowseKeyButton" Grid.Column="3" Style="{StaticResource ButtonStyle}" Width="34" Height="32" VerticalAlignment="Center" Margin="6,0,0,0" Padding="0" Content="&#xE8B7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Visibility="Collapsed" Click="BrowseKey_Click" ToolTip="Choose private key file" AutomationProperties.Name="Browse for private key file" />
            </Grid>

            <TextBlock x:Name="PasswordLabel" Grid.Row="5" Text="Password" VerticalAlignment="Center" />
            <PasswordBox
              x:Name="PasswordBox"
              Grid.Row="5"
              Grid.Column="1"
              Margin="0,0,0,8"
              AutomationProperties.Name="Password"
            />

            <TextBlock x:Name="HostKeyLabel" Grid.Row="6" Text="Server host key" VerticalAlignment="Center" Visibility="Collapsed" />
            <TextBox x:Name="HostKeyBox" Grid.Row="6" Grid.Column="1" Style="{StaticResource EditorTextBox}" Margin="0,0,0,8" Visibility="Collapsed" ToolTip="Optional server identity key supplied by the administrator, for example ssh-ed25519 AAAA…. This is not your private login key." AutomationProperties.Name="Pinned SFTP server host key, optional" />

            <TextBlock Grid.Row="7" Text="Drive name" VerticalAlignment="Center" />
            <TextBox
              x:Name="DisplayNameBox"
              Grid.Row="7"
              Grid.Column="1"
              Style="{StaticResource EditorTextBox}"
              Margin="0,0,0,8"
              AutomationProperties.Name="Drive name"
            />

            <TextBlock Grid.Row="8" Text="Folder (optional)" VerticalAlignment="Center" />
            <TextBox x:Name="RemotePathBox" Grid.Row="8" Grid.Column="1" Style="{StaticResource EditorTextBox}" Margin="0,0,0,8" ToolTip="Optional folder inside this connection" AutomationProperties.Name="Remote folder" />

            <TextBlock Grid.Row="9" Text="Drive letter" VerticalAlignment="Center" />
            <StackPanel Grid.Row="9" Grid.Column="1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <ComboBox
                x:Name="DriveBox"
                Style="{StaticResource EditorComboBox}"
                Width="84"
                AutomationProperties.Name="Drive letter"
              />
              <CheckBox
                x:Name="NetworkModeBox"
                Content="Network drive"
                Margin="16,0,0,0"
                VerticalAlignment="Center"
                ToolTip="Tell Windows this is remote storage. Turning this off presents a local drive."
                AutomationProperties.Name="Present as a network drive"
              />
            </StackPanel>
            <TextBlock Text="Network mode tells Windows this is remote storage. Local mode can attract installer temporary files. Office may create temporary files in either mode."
                       TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,6,0,0" />
            </StackPanel>

            <Expander
              x:Name="AdvancedBox"
              Grid.Row="10"
              Grid.ColumnSpan="2"
              Header="Advanced"
              Margin="0,8,0,0"
            >
              <controls:MountOptionsControl x:Name="OptionsEditor" Margin="0,4,0,0" />
            </Expander>
          </Grid>
        </Border>

        <Border Style="{StaticResource Card}" Padding="12" Margin="0,8,0,0">
          <StackPanel>
            <CheckBox
              x:Name="AutoMountBox"
              Style="{StaticResource ToggleSwitch}"
              Content="{x:Static local:ProductInfo.MountOnStartText}"
              IsChecked="True"
              AutomationProperties.Name="{x:Static local:ProductInfo.MountOnStartText}"
            />
            <CheckBox
              x:Name="StartWithWindowsBox"
              Style="{StaticResource ToggleSwitch}"
              Content="{x:Static local:ProductInfo.StartWithWindowsText}"
              IsChecked="True"
              Margin="0,7,0,0"
              AutomationProperties.Name="{x:Static local:ProductInfo.StartWithWindowsText}"
            />
            <Grid Margin="0,10,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Path
                x:Name="WinFspIcon"
                Style="{StaticResource StatusIcon}"
                Margin="0,0,9,0"
              />
              <TextBlock
                x:Name="WinFspText"
                Grid.Column="1"
                Text="Checking WinFsp…"
                VerticalAlignment="Center"
                Foreground="{StaticResource MutedBrush}"
                TextWrapping="Wrap"
              />
              <Button
                x:Name="WinFspButton"
                Grid.Column="2"
                Style="{StaticResource ButtonStyle}"
                Content="Official releases"
                Visibility="Hidden"
                Margin="10,0,0,0"
                Click="OpenWinFsp_Click"
              />
            </Grid>
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>

    <Grid Grid.Row="2" Margin="0,10,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock
        x:Name="StatusText"
        Foreground="{StaticResource MutedBrush}"
        VerticalAlignment="Center"
        TextTrimming="CharacterEllipsis"
        ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
        AutomationProperties.LiveSetting="Polite"
        Margin="0,0,16,0"
      />
      <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
        <Button
          x:Name="CancelButton"
          Style="{StaticResource ButtonStyle}"
          Content="Cancel"
          IsCancel="True"
          Margin="0,0,8,0"
          Click="Cancel_Click"
        />
        <Button
          x:Name="ConnectButton"
          Style="{StaticResource AccentButton}"
          Content="Add drive"
          IsEnabled="False"
          IsDefault="True"
          Click="Connect_Click"
        />
      </StackPanel>
      <controls:ScrollBarGutter Grid.Column="2" ScrollOwner="{Binding ElementName=SetupScrollViewer}" />
    </Grid>
  </Grid>
</Window>
