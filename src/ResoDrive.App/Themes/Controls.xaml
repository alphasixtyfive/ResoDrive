      <Grid Background="Transparent" MinHeight="32"><Grid.ColumnDefinitions><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Path x:Name="Chevron" Data="M 1 0 L 5 4 L 1 8" Stroke="{StaticResource MutedBrush}" StrokeThickness="1.5" Width="6" Height="9" RenderTransformOrigin=".5,.5"><Path.RenderTransform><RotateTransform Angle="0" /></Path.RenderTransform></Path>
        <ContentPresenter Grid.Column="1" VerticalAlignment="Center" RecognizesAccessKey="True" />
