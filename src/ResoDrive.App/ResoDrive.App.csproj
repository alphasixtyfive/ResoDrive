<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="..\ResoDrive.Core\ResoDrive.Core.csproj" />
    <ProjectReference Include="..\ResoDrive.Windows\ResoDrive.Windows.csproj" />
    <ProjectReference Include="..\ResoDrive.Host\ResoDrive.Host.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>ResoDrive.App</RootNamespace>
    <AssemblyName>$(ExecutableBaseName)</AssemblyName>
    <Product>$(ProductDisplayName)</Product>
    <AssemblyTitle>$(ProductDisplayName)</AssemblyTitle>
    <Description>$(ProductDescription)</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>resodrive.ico</ApplicationIcon>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <SelfContained>false</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishTrimmed>false</PublishTrimmed>
    <CETCompat>true</CETCompat>
    <StartupObject>ResoDrive.App.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\resodrive-mark.png" />
  </ItemGroup>
</Project>
